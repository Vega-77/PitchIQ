rules_version = '2';

// PitchIQ security rules.
//
// This database holds names and email addresses of high school students, so two
// principles drive the whole design:
//
//   1. Authorization NEVER comes from a document the subject can write. A user
//      controls their own users/{uid} doc completely, so it is treated as a UI
//      hint with zero authority. Coach access is proven by teams/{t}.coachUids;
//      player identity by teams/{t}/players/{p}.linkedUid.
//
//   2. Players never read live match data. Firestore evaluates a list rule once
//      against the query, not per document, so there is no way to grant partial
//      access to a collection. Players read only denormalized playerReports docs
//      scoped to their own uid.

service cloud.firestore {
  match /databases/{db}/documents {

    // ------------------------------------------------------------------
    // Identity
    // ------------------------------------------------------------------

    function uid() {
      return request.auth.uid;
    }

    function email() {
      return request.auth.token.get('email', '').lower();
    }

    // Google sign-in with a verified address is the only accepted identity.
    // The provider check matters even though only Google is enabled today:
    // turning on Email/Password is one click in the console, and without this
    // an attacker could register an unverified victim@school.edu and use it to
    // claim that student's roster slot.
    function ident() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && email() != '';
    }

    // ------------------------------------------------------------------
    // Authorization — always derived from the path, never from payload
    // ------------------------------------------------------------------

    function team(t) {
      return get(/databases/$(db)/documents/teams/$(t)).data;
    }

    function isCoach(t) {
      return ident() && uid() in team(t).coachUids;
    }

    // Whoever runs the tablet may write the match log but never reads rosters
    // (which hold students' emails) or finished player reports.
    function isTagger(t) {
      return ident() && (uid() in team(t).coachUids || uid() in team(t).taggerUids);
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The role an outstanding invite names for this account on this team, or
    // 'none'.
    //
    // This is a weaker trust chain than the player claim below, and knowingly
    // so. A player claim re-verifies against the roster document's own stored
    // email and ignores the invite entirely; there is no second document for a
    // coach, so here the invite IS the grant. That is acceptable because only
    // an existing coach of team t can create it (see the invites rule), it is
    // keyed by the invitee's address, and claiming still requires a verified
    // Google token for exactly that address.
    function staffInvitePath(t) {
      return /databases/$(db)/documents/invites/$(email())/from/$(t);
    }

    function invitedAs(t) {
      return exists(staffInvitePath(t))
        ? get(staffInvitePath(t)).data.get('role', 'player')
        : 'none';
    }

    // Firestore doc IDs cannot contain '/', which is legal in an email local
    // part, and IDs matching __.*__ are reserved. Emails are stored and keyed
    // lowercase because Google Workspace commonly returns mixed case while
    // Gmail returns lowercase — a mismatch that passes local testing and fails
    // against a real school domain.
    function emailShape(s) {
      return s is string
        && s.size() <= 254
        && s == s.lower()
        && s.matches('^[^@/\\s]+@[^@/\\s]+[.][^@/\\s]+$');
    }

    // A player with no email address is an ordinary player — they just cannot
    // be invited, which the roster says out loud ("No email yet — they cannot
    // see their report without one"). `emailShape` is exactly right for an
    // invite key, where a blank is meaningless, and was wrong here: it rejected
    // every roster document without an address, so a coach could not add such a
    // player at all, and could not rename, renumber or deactivate one that
    // predated the check. Found by pressing the button in a browser; every
    // emulator test happened to use a player who had an email.
    function optionalEmail(s) {
      return s == null || s == '' || emailShape(s);
    }

    // Which line of the team a player is in. A closed set rather than a string,
    // because a free-text field on a roster is somewhere to type anything at
    // all about a named minor, and the only thing reading it wants is one of
    // four values. Null is the honest default and stays permitted forever —
    // most squads will never fill this in for the whole roster.
    function validPosition(p) {
      return p == null || p in ['gk', 'def', 'mid', 'fwd'];
    }

    function isTimestampNow(v) {
      return v == request.time;
    }

    // A match video link, which the player portal turns into an embedded
    // player and seeks around. https only: the site is served over HTTPS, so
    // an http:// link is blocked as mixed content and would look like a broken
    // page rather than a rejected setting. javascript: and data: are refused
    // for the obvious reason — this string ends up in an element's src.
    function validVideo() {
      return (request.resource.data.get('videoUrl', null) == null
              || (request.resource.data.videoUrl is string
                  && request.resource.data.videoUrl.size() <= 500
                  && request.resource.data.videoUrl.matches('https://.*')))
        && (request.resource.data.get('videoOffsetS', null) == null
            || (request.resource.data.videoOffsetS is number
                && request.resource.data.videoOffsetS >= -3600
                && request.resource.data.videoOffsetS <= 36000))
        // Where in the footage the second half kicks off. The second anchor of
        // the clock map: with only the first, every second-half timestamp is
        // out by the length of the interval. Never negative — it is a position
        // in a file, and one before the start of the file is not a typo worth
        // storing.
        && (request.resource.data.get('secondHalfVideoS', null) == null
            || (request.resource.data.secondHalfVideoS is number
                && request.resource.data.secondHalfVideoS >= 0
                && request.resource.data.secondHalfVideoS <= 36000));
    }

    // What the tablet's clock read when the first half ended — which, because
    // the clock freezes for the break, is also what it read when the second
    // half kicked off. Written by the tagger at the half-time tap, not typed by
    // anyone, so the bound is the same MAX_CLOCK_S the log entries carry.
    function validHalfTimeClock() {
      return request.resource.data.get('halfTimeClockS', null) == null
        || (request.resource.data.halfTimeClockS is number
            && request.resource.data.halfTimeClockS > 0
            && request.resource.data.halfTimeClockS <= 12000);
    }

    // The xG check tally on a match document. Null is the real, common answer:
    // it means nobody has marked a shot in this match, and every bound below is
    // an actual invariant of the arithmetic rather than a guessed cap.
    //
    // `predicted` is a sum of probabilities so it cannot exceed the shot count;
    // `variance` is a sum of p(1-p) so it cannot either; and a team cannot score
    // more goals than it took shots. A document that breaks one of those would
    // silently corrupt the season figure, which is summed without re-checking.
    function xgCheck() {
      return request.resource.data.xgCheck;
    }
    function validXgCheck() {
      return request.resource.data.get('xgCheck', null) == null
        || (xgCheck().keys().hasOnly(['shots', 'predicted', 'scored', 'variance'])
            && xgCheck().shots is int
            && xgCheck().shots > 0
            && xgCheck().shots <= 200
            && xgCheck().scored is int
            && xgCheck().scored >= 0
            && xgCheck().scored <= xgCheck().shots
            && xgCheck().predicted is number
            && xgCheck().predicted >= 0
            && xgCheck().predicted <= xgCheck().shots
            && xgCheck().variance is number
            && xgCheck().variance >= 0
            && xgCheck().variance <= xgCheck().shots);
    }

    // ------------------------------------------------------------------
    // users — UI hints only. Forging this document achieves nothing.
    // ------------------------------------------------------------------

    match /users/{userId} {
      allow read, delete: if ident() && userId == uid();

      allow create, update: if ident()
        && userId == uid()
        && request.resource.data.keys().hasOnly(
             ['displayName', 'emailLower', 'teamIds', 'lastPlayerRef', 'updatedAt'])
        && request.resource.data.emailLower == email()
        && request.resource.data.teamIds is list
        && request.resource.data.teamIds.size() <= 10;
    }

    // ------------------------------------------------------------------
    // coachAllowlist — managed by hand in the console.
    //
    // Denying all client access does not break the exists() check below:
    // get()/exists() inside rules run with full privileges and bypass rules.
    // ------------------------------------------------------------------

    match /coachAllowlist/{emailKey} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // teams
    // ------------------------------------------------------------------

    match /teams/{t} {
      // A pending invitee can read the team so the claim below can compute the
      // new staff array — they cannot read it any other way, and they are being
      // invited onto this team regardless. Uids are opaque.
      allow get: if isCoach(t) || isTagger(t)
        || (ident() && invitedAs(t) in ['coach', 'tagger']);
      allow list: if false;

      // Separate from update because isCoach(t) would get() a document that does
      // not exist yet, raise an evaluation error, and deny. This is the only
      // genuine bootstrap in the ruleset.
      allow create: if ident()
        && exists(/databases/$(db)/documents/coachAllowlist/$(email()))
        && request.resource.data.keys().hasOnly(
             ['name', 'coachUids', 'taggerUids', 'archived', 'createdAt', 'createdBy'])
        && request.resource.data.coachUids == [uid()]
        && request.resource.data.taggerUids == []
        && request.resource.data.createdBy == uid()
        && isTimestampNow(request.resource.data.createdAt)
        && request.resource.data.archived == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      // isCoach(t) reads resource.data — the PRE-write value. Testing
      // request.resource.data here would let anyone add themselves as a coach.
      //
      // A school may run varsity and JV under one head coach with assistants,
      // so a team carries several coaches and a coach carries several teams.
      allow update: if isCoach(t)
        && changed(['name', 'coachUids', 'taggerUids', 'archived'])
        && uid() in request.resource.data.coachUids
        && request.resource.data.coachUids.size() >= 1
        && request.resource.data.coachUids.size() <= 6
        && request.resource.data.taggerUids.size() <= 6
        // Only the coach who created the team may drop another coach, so an
        // assistant cannot lock the head coach out of their own squad.
        && (request.resource.data.coachUids.size() >= resource.data.coachUids.size()
            || uid() == resource.data.createdBy);

      // The staff claim. An invited coach adds themselves, and only themselves.
      // The result must equal the existing array with exactly this uid appended,
      // so the same rule cannot be used to rename the team, drop a colleague,
      // or add a third party.
      allow update: if ident()
        && changed(['coachUids'])
        && invitedAs(t) == 'coach'
        && !(uid() in resource.data.coachUids)
        && request.resource.data.coachUids == resource.data.coachUids.concat([uid()])
        && request.resource.data.coachUids.size() <= 6;

      // Firestore does not cascade deletes. Removing a team would orphan every
      // subcollection permanently — unreadable (isCoach() would error on the
      // missing doc), undeletable by any client, and still billed. Archive.
      allow delete: if false;

      // ---- staff directory: names for the uids in coachUids ----
      //
      // Display only, never authorization — coachUids remains the sole proof of
      // who coaches this team. It exists because a coach cannot read another
      // coach's users/{uid} document, so without it the staff list would be a
      // column of opaque uids. Self-written, and the address has to match the
      // verified token, so nobody can misattribute an entry.
      match /staff/{s} {
        allow read: if isCoach(t) || isTagger(t);

        allow create, update: if ident()
          && s == uid()
          && (uid() in team(t).coachUids || uid() in team(t).taggerUids)
          && request.resource.data.keys().hasOnly(
               ['displayName', 'emailLower', 'role', 'joinedAt'])
          && request.resource.data.emailLower == email()
          && request.resource.data.role in ['coach', 'tagger']
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80;

        allow delete: if isCoach(t);
      }

      // ---- roster: holds students' email addresses, so coach-only ----
      match /players/{p} {
        allow list: if isCoach(t);
        allow get: if isCoach(t) || (ident() && resource.data.linkedUid == uid());

        allow create: if isCoach(t)
          && request.resource.data.keys().hasOnly(
               ['name', 'jerseyNumber', 'emailLower', 'position', 'linkedUid',
                'active', 'createdAt'])
          && request.resource.data.linkedUid == null
          && optionalEmail(request.resource.data.emailLower)
          && validPosition(request.resource.data.get('position', null))
          && request.resource.data.active is bool
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (request.resource.data.jerseyNumber == null
              || (request.resource.data.jerseyNumber is int
                  && request.resource.data.jerseyNumber >= 0
                  && request.resource.data.jerseyNumber <= 99));

        // A coach may edit the roster and may unlink (a student changed email),
        // but may never point a roster slot at an arbitrary account. Linking is
        // done only by the account owner, in the rule below.
        allow update: if isCoach(t)
          && changed(['name', 'jerseyNumber', 'emailLower', 'position',
                      'linkedUid', 'active'])
          && (request.resource.data.linkedUid == null
              || request.resource.data.linkedUid == resource.data.linkedUid)
          && optionalEmail(request.resource.data.emailLower)
          && validPosition(request.resource.data.get('position', null));

        // The claim: the only write a player ever makes to team data. It is
        // self-verifying — it checks the roster document's own stored email
        // against the verified token, and does not trust the invite at all.
        allow update: if ident()
          && changed(['linkedUid'])
          && resource.data.linkedUid == null
          && request.resource.data.linkedUid == uid()
          && resource.data.emailLower == email();

        allow delete: if isCoach(t);
      }

      // ---- matches ----
      match /matches/{m} {
        allow get, list: if isTagger(t);

        allow create: if isTagger(t)
          && request.resource.data.keys().hasOnly(
               ['opponentName', 'date', 'status', 'finalized',
                'scoreUs', 'scoreThem', 'videoUrl', 'videoOffsetS',
                'secondHalfVideoS', 'halfTimeClockS',
                'createdAt', 'createdBy'])
          && request.resource.data.opponentName is string
          && request.resource.data.opponentName.size() <= 80
          && request.resource.data.status in
               ['scheduled', 'first_half', 'halftime', 'second_half', 'full_time']
          && request.resource.data.finalized == false
          && request.resource.data.createdBy == uid()
          && validVideo()
          && validHalfTimeClock()
          && isTimestampNow(request.resource.data.createdAt);

        allow update: if isTagger(t)
          && changed(['opponentName', 'date', 'status', 'finalized',
                      'scoreUs', 'scoreThem', 'videoUrl', 'videoOffsetS',
                      'secondHalfVideoS', 'halfTimeClockS'])
          && request.resource.data.status in
               ['scheduled', 'first_half', 'halftime', 'second_half', 'full_time']
          && validVideo()
          && validHalfTimeClock();

        // The xG check: four numbers summarising which of this match's shots a
        // coach has marked, and what the model predicted for them. Stored here
        // rather than in cvReview so the season figure costs no extra reads —
        // the dashboard already loads every match document.
        //
        // A separate rule from the one above because that one lets a *tagger*
        // write, and this is a coach's judgement about the model rather than a
        // fact about the match. Same reasoning that keeps cvMapping out of
        // cvStats: a correction must never be writable by whoever can write a
        // measurement.
        allow update: if isCoach(t)
          && changed(['xgCheck'])
          && validXgCheck();

        allow delete: if isCoach(t);

        match /roster/{p} {
          allow read: if isTagger(t);

          allow create: if isTagger(t)
            && request.resource.data.keys().hasOnly(
                 ['playerName', 'jerseyNumber', 'isStarter', 'isActive', 'stints', 'version'])
            && request.resource.data.version == 0
            && request.resource.data.stints is list
            && request.resource.data.isStarter is bool
            && request.resource.data.isActive is bool;

          // Optimistic lock. writeBatch alone gives atomicity but not
          // compare-and-swap; this makes a conflicting concurrent write fail at
          // sync time instead of silently clobbering. Unlike runTransaction it
          // still works offline, which is the actual match-day condition.
          allow update: if isTagger(t)
            && changed(['isStarter', 'isActive', 'stints', 'version'])
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.stints is list
            && request.resource.data.stints.size() <= 20;

          allow delete: if isCoach(t);
        }

        // ---- log: one append-only stream of events, subs, and periods ----
        match /log/{entryId} {
          allow read: if isTagger(t);

          allow create: if isTagger(t)
            && request.resource.data.keys().hasOnly(
                 ['kind', 'type', 'matchClockS', 'side', 'playerId',
                  'assistPlayerId', 'cardColor',
                  'subOutId', 'subInId', 'detail', 'source', 'seq', 'deviceId',
                  'revert', 'tappedAt', 'createdAt', 'createdBy'])
            && request.resource.data.kind in ['event', 'sub', 'period']
            // A card must say which colour, and nothing else may carry one.
            && (request.resource.data.get('cardColor', null) == null
                ? request.resource.data.type != 'card'
                : (request.resource.data.type == 'card'
                   && request.resource.data.cardColor in
                        ['yellow', 'red', 'second_yellow']))
            // Only a goal can have an assist, and never to the scorer.
            && (request.resource.data.get('assistPlayerId', null) == null
                || (request.resource.data.type == 'goal'
                    && request.resource.data.side == 'us'
                    && request.resource.data.assistPlayerId
                       != request.resource.data.get('playerId', '')))
            && request.resource.data.type in [
                 'out_of_bounds', 'corner', 'throw_in', 'goal_kick', 'free_kick',
                 'foul', 'card', 'goal', 'offside',
                 'kickoff_1st', 'halftime', 'kickoff_2nd', 'full_time', 'sub']
            && request.resource.data.source in
                 ['live_tag', 'cv_candidate', 'reviewer_confirmed']
            && request.resource.data.matchClockS is number
            && request.resource.data.matchClockS >= 0
            && request.resource.data.matchClockS <= 12000
            && (request.resource.data.side == null
                || request.resource.data.side in ['us', 'them'])
            // There is no opponent roster, so an opponent event can never carry
            // one of our player IDs.
            && (request.resource.data.playerId == null
                || request.resource.data.side == 'us')
            && (request.resource.data.detail == null
                || (request.resource.data.detail is string
                    && request.resource.data.detail.size() <= 200))
            && request.resource.data.seq is int
            && request.resource.data.seq >= 0
            && request.resource.data.createdBy == uid()
            && isTimestampNow(request.resource.data.createdAt);

          // Append-only: corrections are new entries, not rewrites.
          allow update: if false;
          allow delete: if isTagger(t);
        }

        // ---- cvStats: what the video pipeline derived ----
        //
        // Written only by cv/publish.py through the Admin SDK, which bypasses
        // these rules entirely. So the write rule here is not what protects the
        // data — it is what stops anyone else forging it. A coach reading a
        // stat line has no way to tell a figure the pipeline produced from one
        // a browser posted, and `if false` is the only thing that keeps that
        // distinction real.
        //
        // Deliberately a separate collection rather than entries in `log`: the
        // tagged log is a human record of what happened, and mixing estimates
        // into it would make an unreliable CV run corrupt the one source of
        // truth in the app.
        match /cvStats/{doc} {
          allow get, list: if isTagger(t);
          allow write: if false;
        }

        // ---- the cropped pictures, and the one thing a client may do to them
        //
        // `cvStats` is written only by the Admin SDK, and the rule above is what
        // keeps that true: a coach reading a stat line has no way to tell a
        // figure the pipeline produced from one a browser posted.
        //
        // Deleting is not forging. This grants a coach delete on exactly one
        // document — the photographs of their players, cut out of the footage so
        // they could be matched to a name — and nothing else. They cannot create
        // it, cannot edit it, and cannot touch any document holding a number.
        // The invariant that matters is that no client may *invent* a
        // statistic, and destroying a picture cannot invent anything.
        //
        // Rules are a union of grants, so this sits alongside the block above
        // rather than replacing it: everything not named here is still denied.
        match /cvStats/thumbs {
          allow delete: if isCoach(t);
        }

        // ---- cvMapping: which tracked figure is which player ----
        //
        // Deliberately NOT part of cvStats. That collection is written only by
        // the pipeline through the Admin SDK and is read-only to every client,
        // which is what keeps "a machine derived this" a true statement about
        // it. This document is the opposite: a human's judgement about who is
        // who, and only a coach can make it.
        //
        // Keeping them apart means a coach correcting an identity can never
        // look like the pipeline having measured something.
        match /cvMapping/{doc} {
          allow get, list: if isTagger(t);

          allow create, update: if isCoach(t)
            && request.resource.data.keys().hasOnly(
                 ['byCluster', 'updatedAt', 'updatedBy'])
            && request.resource.data.byCluster is map
            // A tracked half yields tens of clusters, not hundreds. A cap
            // stops a runaway write from becoming an unreadable document.
            && request.resource.data.byCluster.size() <= 200
            && request.resource.data.updatedBy == uid()
            && isTimestampNow(request.resource.data.updatedAt);

          allow delete: if isCoach(t);
        }

        // ---- cvReview: a human's verdict on what the pipeline claimed ----
        //
        // The same split as cvMapping, for the same reason. cvStats says what
        // the video appeared to show and no client may touch it; this says what
        // a coach thinks of that, and only a coach may write it. Keeping them
        // apart means a correction can never be mistaken for a measurement.
        //
        // One document rather than one per event: a review session is hundreds
        // of small decisions, and hundreds of writes on a phone at the side of
        // a pitch is not the same thing as one debounced write.
        //
        // The shapes inside `byEvent` and `missed` are not validated here.
        // Rules cannot reach into a nested map, which cvMapping already lives
        // with. The client validates; these caps are what stop a runaway write
        // becoming a document nobody can read.
        match /cvReview/{doc} {
          allow get, list: if isTagger(t);

          allow create, update: if isCoach(t)
            && request.resource.data.keys().hasOnly(
                 ['byEvent', 'missed', 'updatedAt', 'updatedBy'])
            && request.resource.data.byEvent is map
            && request.resource.data.byEvent.size() <= 1500
            && request.resource.data.missed is list
            && request.resource.data.missed.size() <= 300
            && request.resource.data.updatedBy == uid()
            && isTimestampNow(request.resource.data.updatedAt);

          allow delete: if isCoach(t);
        }

        // ---- playerReports: the only team data a player ever reads ----
        match /playerReports/{p} {
          allow get, list: if isCoach(t);

          // validVideo() matters more here than on the match document. This is
          // the copy the player portal actually reads, and the string in it
          // becomes an iframe src on a page a sixteen-year-old opens. The match
          // document has been guarded since the field existed; this one was
          // reachable through the same coach account and was not.
          allow create, update: if isCoach(t)
            && request.resource.data.published is bool
            && request.resource.data.minutesPlayed is number
            && request.resource.data.minutesPlayed >= 0
            && request.resource.data.goals is int
            && request.resource.data.goals >= 0
            && validVideo()
            && validHalfTimeClock();

          allow delete: if isCoach(t);
        }
      }
    }

    // ------------------------------------------------------------------
    // invites — a pointer, not a grant. Claiming is verified against the
    // roster document itself, so a forged invite gains nothing.
    // ------------------------------------------------------------------

    match /invites/{emailKey}/from/{t} {
      // Path-derived, so the list rule is provable and nobody can enumerate
      // students' addresses.
      allow get, list: if ident() && emailKey == email();

      // A player invite must point at a real roster slot. A staff invite has no
      // roster slot to point at, so it must carry no playerId at all — that
      // keeps the two kinds from being confused for one another.
      allow create, update: if isCoach(t)
        && emailShape(emailKey)
        && request.resource.data.keys().hasOnly(
             ['playerId', 'role', 'teamName', 'coachName', 'createdAt', 'createdBy'])
        && isTimestampNow(request.resource.data.createdAt)
        && request.resource.data.get('role', 'player') in ['player', 'coach', 'tagger']
        && (request.resource.data.get('role', 'player') == 'player'
            ? exists(/databases/$(db)/documents/teams/$(t)/players/$(request.resource.data.get('playerId', '')))
            : request.resource.data.get('playerId', null) == null);

      allow delete: if isCoach(t);
    }

    // ------------------------------------------------------------------
    // Player portal — the one collection-group grant.
    //
    // Safe because the condition is uid-scoped rather than path-scoped: a
    // recursive wildcard with a path-based condition would be a footgun.
    // Requires the client query to filter on linkedUid, which is what makes it
    // provable at all.
    // ------------------------------------------------------------------

    match /{path=**}/playerReports/{p} {
      allow get, list: if ident()
        && resource.data.linkedUid == uid()
        && resource.data.published == true;
    }
  }
}
