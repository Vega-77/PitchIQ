# Training data caches — xg_raw_shots_cache.pkl is ~117MB, over GitHub's 100MB limit.
# Rebuilt automatically by PitchIQHelper/main.py from the StatsBomb API.
*.pkl

# Python
.venv/
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# CV experiment scratch output / pretrained weights
/runs/
/scratch_frames/
*.pt

# Local database
*.db
*.sqlite3

# Node
node_modules/

# Firebase — service account keys bypass security rules entirely, so make it
# hard to commit one by accident. The web API key in firebase-init.js is fine.
*serviceAccount*.json
*-firebase-adminsdk-*.json
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
